{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "obsidian": ["node_modules/obsidian"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts"]
}
